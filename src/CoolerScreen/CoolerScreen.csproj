<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CoolerScreen</AssemblyName>
    <RootNamespace>CoolerScreen</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Cooler Screen</Product>
    <Company>bhxuk</Company>
    <Copyright>Copyright (c) 2026 bhxuk</Copyright>
    <Description>Cooler Screen: GIFs, pictures, clocks and live stats on the CORSAIR NAUTILUS RS LCD, without iCUE.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\coolerscreen.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <StartupObject>CoolerScreen.Program</StartupObject>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416;CS8632;CS0618;WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoolerScreen.Render\CoolerScreen.Render.csproj" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.9" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\coolerscreen.ico" />
    <Resource Include="Assets\coolerscreen-256.png" />
  </ItemGroup>

</Project>
