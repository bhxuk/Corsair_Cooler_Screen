<Project Sdk="Microsoft.NET.Sdk">

  <!-- Draws the 480x480 screens. No Windows-only code here, so the screens can be rendered and checked anywhere. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CoolerScreen.Render</RootNamespace>
    <AssemblyName>CoolerScreen.Render</AssemblyName>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

</Project>
